mkdir -p target/linux/ramips/mt7621/base-files/etc/init.d

cat > target/linux/ramips/mt7621/base-files/etc/init.d/irqbalance-mt7621 << 'EOF'
#!/bin/sh /etc/rc.common
# ImmortalWrt MT7621 Performance Tuning
START=99
STOP=10

start() {
    grep -q "mt7621" /proc/cpuinfo || return 0
    
    echo "Applying MT7621 optimizations..."
    
    local RPS_MASK="f"
    
    for iface in /sys/class/net/*; do
        dev=$(basename "$iface")
        case "$dev" in
            lo|docker*|br-*|veth*|wg*|ppp*|@*) continue ;;
        esac
        
        [ -f "$iface/queues/rx-0/rps_cpus" ] && echo $RPS_MASK > "$iface/queues/rx-0/rps_cpus"
        [ -f "$iface/queues/tx-0/xps_cpus" ] && echo $RPS_MASK > "$iface/queues/tx-0/xps_cpus"
    done
    
    [ -d "/sys/class/net/br-lan" ] && echo $RPS_MASK > /sys/class/net/br-lan/queues/rx-0/rps_cpus
}

stop() { :; }
EOF
